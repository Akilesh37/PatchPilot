# PatchPilot Environment Configuration Example
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DATABASE_URL=sqlite:///./patchpilot.db
API_PREFIX=/api

# Retrieval & Vector Database Configuration
RETRIEVAL_BACKEND=bm25 # Options: bm25, hybrid
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ML / Model Configuration
MODEL_PROVIDER=mock # Options: mock, huggingface, openai_compatible
MODEL_NAME_OR_PATH=Qwen/Qwen2.5-Coder-3B-Instruct
LORA_ADAPTER_PATH=
DEVICE=cpu # Options: cpu, mps, cuda
MAX_NEW_TOKENS=2048
TEMPERATURE=0.2

# Verification Sandbox Configuration
SANDBOX_MODE=local_process # Options: local_process, docker
EXECUTION_TIMEOUT_SECONDS=180
MAX_REPAIR_ATTEMPTS=2
MAX_CONCURRENT_WORKERS=2
STORAGE_PATH=./data_storage
